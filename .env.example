# ==============================================================================
# D-AMINGROW PLATFORM ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development. Never commit real secrets to Git.
# ==============================================================================

# Public Platform URLs & Contacts
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=+2348139169402

# Supabase Public Keys (Safe for Client Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Privileged Keys (STRICTLY SERVER-SIDE / CLOUDFLARE SECRETS)
# NEVER prefix with NEXT_PUBLIC_ or expose to client bundles!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Transactional Email API (Resend / SendGrid)
RESEND_API_KEY=re_your_api_key_here

# Optional: Application Environment
NODE_ENV=development
